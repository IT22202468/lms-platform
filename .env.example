# Copy this file to .env and fill in all values before running docker compose up.
# .env is gitignored and must never be committed.

# MongoDB Atlas base URI (without database name)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=

# JWT signing secret — use a long random string (e.g. openssl rand -base64 64)
JWT_SECRET=

# Grafana admin password
GF_ADMIN_PASSWORD=
